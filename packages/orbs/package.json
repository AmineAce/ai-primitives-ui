{
  "name": "@ai-primitives-ui/ui",
  "version": "2.2.0",
  "description": "Framework-agnostic Canvas 2D loading orb primitives.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "tailwind-preset.cjs",
    "tailwind-preset.d.cts",
    "tailwind-preset.d.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./src/styles.css": "./src/styles.css",
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.cts",
      "default": "./tailwind-preset.cjs"
    },
    "./tailwind-preset.js": {
      "types": "./tailwind-preset.d.cts",
      "default": "./tailwind-preset.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "pnpm build && publint && attw --pack --exclude-entrypoints \"@ai-primitives-ui/ui/src/styles.css\" \"@ai-primitives-ui/ui/tailwind-preset\" \"@ai-primitives-ui/ui/tailwind-preset.js\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "jsdom": "^30.0.1",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
